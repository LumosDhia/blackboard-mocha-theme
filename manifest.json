{
  "manifest_version": 3,
  "name": "Blackboard Mocha",
  "version": "0.2.0",
  "description": "Catppuccin Mocha theme for Blackboard Learn (Esprit), with the course list rebuilt from Blackboard's own REST API. Client-side only.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blackboard-mocha@lumosdhia"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://esprit.blackboard.com/ultra/course*"
      ],
      "js": [
        "boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://esprit.blackboard.com/*"
      ],
      "css": [
        "mocha.css",
        "courselist.css"
      ],
      "js": [
        "shared.js",
        "rail.js",
        "tasks.js",
        "content.js",
        "courselist.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rail-art.jpg"
      ],
      "matches": [
        "https://esprit.blackboard.com/*"
      ]
    }
  ]
}
